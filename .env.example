# Configuracion de claude-retry. Copia este archivo a `.env` y ajusta lo que quieras.
# Todas las variables son opcionales; lo no definido usa su valor por defecto.

# Reintentos maximos tras detectar el limite.
# CR_MAX_RETRIES=5

# Margen extra (segundos) tras la hora de reinicio detectada.
# CR_MARGIN_SECONDS=30

# Espera (horas) si no se logra leer la hora de reinicio.
# CR_FALLBACK_HOURS=5

# Ruta al binario de claude. Por defecto se resuelve automaticamente.
# CR_CLAUDE_BIN=C:\ruta\a\claude.cmd

# --- Deteccion de limite ---------------------------------------------------
# Precision requerida para la deteccion ESTADISTICA de variantes no catalogadas.
# Es el umbral de confianza minimo (0-100, o 0-1) para disparar el reintento por
# puntuacion ponderada. Mas alto = mas estricto; mas bajo = mas sensible.
CR_DETECTION_PRECISION=70

# Pon a 1 para ver en stderr la confianza y las senales que casaron (calibracion).
# CR_DETECT_DEBUG=0

# --- Verificacion anti falso positivo (solo modo interactivo) ---------------
# Al ver un patron de limite NO mata la sesion de inmediato: espera a que la
# salida se calme y envia una sonda ("continue") para comprobar si el limite es
# real (reaparece el banner) o si claude solo lo MENCIONABA (responde normal).
# Pon a 0 para volver al corte inmediato clasico.
# CR_VERIFY=1
# Ms que la salida debe estar quieta tras el patron antes de enviar la sonda.
# CR_VERIFY_IDLE_MS=1500
# Ms de espera a la respuesta de la sonda antes de decidir.
# CR_VERIFY_WINDOW_MS=8000

# --- Comportamiento interactivo --------------------------------------------
# CR_AUTO_CONFIRM=1
# CR_AUTO_CONFIRM_KEY=enter
# CR_CONTINUE_ON_RETRY=0

# Volcar TODA la salida a un archivo (util con winpty en VSCode).
# CR_TRANSCRIPT=session.log
