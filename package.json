{
  "name": "claude-retry",
  "version": "1.0.0",
  "description": "Envoltorio Windows-nativo de claude que reintenta al alcanzar el limite de uso (con streaming y modo interactivo via PTY).",
  "type": "module",
  "bin": {
    "claude-retry": "claude-retry.mjs"
  },
  "scripts": {
    "start": "node claude-retry.mjs",
    "promote": "npm install -g .",
    "test": "node tests/test-detection.mjs && node tests/test-verify.mjs",
    "test:detection": "node tests/test-detection.mjs",
    "test:verify": "node tests/test-verify.mjs"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.0.0"
  }
}
